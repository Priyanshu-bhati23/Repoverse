# Required. Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Raises GitHub's limit from 60 to 5,000 requests an hour and allows private repos.
# A fine-grained token with read-only "Contents" access is enough.
GITHUB_TOKEN=

# Optional. Override the models if Groq retires the defaults.
# GROQ_MODEL_SMART=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b
